# 拷贝为本仓库根目录下的 .env 后再填值；.env 已被 .gitignore 拦住，不会提交。
# 千万不要把真实密钥写入 .env.example 或 README。

# --- HTTP ---
APP_ADDR=:8080
APP_SHUTDOWN_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- PostgreSQL ---
DATABASE_DSN=host=localhost user=postgres password=postgres dbname=ai_drama port=5432 sslmode=disable TimeZone=Asia/Shanghai

# --- Redis（钱相关接口 Idempotency-Key 强幂等；生产建议必填）---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
IDEMPOTENCY_TTL_SECONDS=1800

# --- Rate Limit（生产建议开启；按 IP + 路径限流）---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# --- 告警 Webhook（失败不阻断主业务）---
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_SECONDS=3

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=168

# --- SMS 行为 ---
# true：dev provider，仅写 sms_codes 表 + 日志，并把 dev_code 透传到响应。
# false：tencent provider，需要下面腾讯云配置齐全 + 验证码模板审核通过。
SMS_DEV_MODE=true
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_WINDOW_SECONDS=60
SMS_MAX_VERIFY_ATTEMPTS=5
SMS_VERIFY_LOCK_SECONDS=900
SMS_SEND_IP_RPS=0.2
SMS_SEND_IP_BURST=3

# --- 初始管理员（首次启动自动创建，已存在则跳过）---
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123

# --- 安全 ---
BCRYPT_COST=10
# 32 字节 base64，生成：openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# --- 钱相关 ---
CREATOR_SHARE_RATE=0.5
MIN_WITHDRAWAL_CENTS=1000
ORDER_PENDING_TTL_SECONDS=1800

# --- 腾讯云通用密钥（命名对齐腾讯云官方 SDK）---
# 在 https://console.cloud.tencent.com/cam/capi 新建；
# SecretKey 仅在创建时显示一次，请妥善保存到密码管理器（不要再粘进聊天 / 文档）。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# --- 腾讯云 SMS（SMS_DEV_MODE=false 时才会真正调用）---
# SMS_SDK_APP_ID：在「短信应用」列表里拿，例如 1401130267
# SMS_SIGN_NAME：「正文签名」必须是已审核通过的签名文案，公司名要与营业执照一致
# SMS_TEMPLATE_LOGIN：「正文模板管理」里类目=验证码、已审核通过的模板 ID
#                    没有审核通过的验证码模板时此项保持空，provider 会退回 DevProvider
# SMS_REGION：建议 ap-guangzhou，与短信应用所在地域一致
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_LOGIN=
# 占位符顺序，逗号分隔；可选项：code / ttl_minutes
# 单参数模板（仅 {1}=验证码）：code
# 双参数模板（{1}=验证码 {2}=分钟）：code,ttl_minutes
SMS_TEMPLATE_LOGIN_PARAMS=code
SMS_REGION=ap-guangzhou

# --- 支付 ---
# PAYMENT_DEV_MODE=true：所有支付渠道走 DevProvider —— prepay 返 stub 参数，webhook 不验签
#   此模式额外暴露 POST /v1/dev/orders/:order_no/pay 用于前端一键模拟支付成功（仅联调用）
# PAYMENT_DEV_MODE=false：必须补齐 wechat / alipay 完整配置才会启用对应渠道；缺哪个该渠道下单直接 503
# 上线前务必切到 false 并填齐密钥，否则会接收伪造回调
PAYMENT_DEV_MODE=true
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY_V3=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# --- Mock 数据 ---
# SEED_MOCK_DATA=true：服务启动时自动灌一批 mock 短剧 / 剧集 / 用户 / 订单 / 提现，方便前端联调
#   也可以随时手动触发：POST /v1/dev/seed（需 PAYMENT_DEV_MODE=true）
#   幂等：已存在的（按 phone / title / order_no 等业务键）会跳过
#   视频 URL 用 w3.org / test-videos.co.uk / blender / vjs.zencdn 几家真实 mp4 混搭，HTML5 可直接播放
#   生产严禁开启
SEED_MOCK_DATA=false

# --- 腾讯云 COS（图片上传：封面、头像）---
# COS_BUCKET：桶名，格式固定 <name>-<appid>，如 drama-img-1300000000
# COS_REGION：地域，常用 ap-guangzhou / ap-shanghai
# COS_APP_ID：账号 APP_ID（10 位数字），与 bucket 后缀一致
# COS_SECRET_ID / COS_SECRET_KEY：CAM 子账号密钥；建议单独发一对，权限只给 cos:PutObject
# COS_CDN_DOMAIN：自定义 CDN 域名（含 scheme），留空则用 https://<bucket>.cos.<region>.myqcloud.com
# COS_SIGN_EXPIRE_SECONDS：PUT 预签名 URL 有效期，默认 900s（15 分钟）
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_APP_ID=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_CDN_DOMAIN=
COS_SIGN_EXPIRE_SECONDS=900

# --- 腾讯云 VOD（视频上传：剧集）---
# VOD_SUB_APP_ID：点播子应用 ID；填 0 走主应用，推荐填子应用做隔离
# VOD_REGION：VOD 地域，常用 ap-chongqing（默认）
# VOD_SECRET_ID / VOD_SECRET_KEY：CAM 子账号密钥；权限给 vod:ApplyUpload + vod:CommitUpload + vod:DescribeMediaInfos
# VOD_PROCEDURE_NAME：任务流模板名（控制台 → 视频处理 → 任务流模板）；空 → 上传完直接 ready，不走转码
# VOD_CALLBACK_KEY：节点回调签名密钥；空 → handler 跳过验签 + 告警一次，生产必填
# VOD_CDN_DOMAIN：自定义播放域名；留空走 VOD 默认 *.vod-qcloud.com
# VOD_SIGN_EXPIRE_SECONDS：客户端上传签名有效期，默认 3600s（1 小时）
VOD_SUB_APP_ID=0
VOD_REGION=ap-chongqing
VOD_SECRET_ID=
VOD_SECRET_KEY=
VOD_PROCEDURE_NAME=
VOD_CALLBACK_KEY=
VOD_CDN_DOMAIN=
VOD_SIGN_EXPIRE_SECONDS=3600

# --- VOD URL Key 防盗链（/v1/app/episodes/:id/play 返回前签 token，挡 URL 泄露）---
# 开通条件：腾讯 VOD 控制台 → 分发播放 → Key 防盗链「启用」+ 拿到 32 位 KEY 填这里
# 默认 false：直返裸 video_url，联调期保持这个；生产建议 true。
# 算法：sign = md5(KEY + Dir + t + exper + rlimit + us)；具体见 internal/vod/vod.go::SignPlayURL
VOD_PLAY_SIGN_ENABLED=false
VOD_PLAY_SIGN_KEY=
VOD_PLAY_SIGN_EXPIRE_SECONDS=3600
VOD_PLAY_SIGN_EXPER=0
VOD_PLAY_SIGN_RLIMIT=0

# --- COS Referer 防盗链（封面 / 头像盗链保护）---
# 不在代码里强生效，只给 cmd/setup-cos-referer 工具用。
# 设置完跑：./drama-setup-cos-referer  （联调期带 --empty-allow，避免 curl/Apifox 被 403）
# 关掉： ./drama-setup-cos-referer --disable
COS_REFERER_WHITELIST=
