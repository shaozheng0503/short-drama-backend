# 拷贝为本仓库根目录下的 .env 后再填值；.env 已被 .gitignore 拦住，不会提交。
# 千万不要把真实密钥写入 .env.example 或 README。

# --- HTTP ---
APP_ADDR=:8080
APP_SHUTDOWN_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- PostgreSQL ---
DATABASE_DSN=host=localhost user=postgres password=postgres dbname=ai_drama port=5432 sslmode=disable TimeZone=Asia/Shanghai

# --- Redis（钱相关接口 Idempotency-Key 强幂等；生产建议必填）---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
IDEMPOTENCY_TTL_SECONDS=1800

# --- Rate Limit（生产建议开启；按 IP + 路径限流）---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# --- 告警 Webhook（失败不阻断主业务）---
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_SECONDS=3

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=168

# --- SMS 行为 ---
# true：dev provider，仅写 sms_codes 表 + 日志，并把 dev_code 透传到响应。
# false：tencent provider，需要下面腾讯云配置齐全 + 验证码模板审核通过。
SMS_DEV_MODE=true
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_WINDOW_SECONDS=60
SMS_MAX_VERIFY_ATTEMPTS=5
SMS_VERIFY_LOCK_SECONDS=900
SMS_SEND_IP_RPS=0.2
SMS_SEND_IP_BURST=3

# --- 初始管理员（首次启动自动创建，已存在则跳过）---
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123

# --- 安全 ---
BCRYPT_COST=10

# --- 腾讯云通用密钥（命名对齐腾讯云官方 SDK）---
# 在 https://console.cloud.tencent.com/cam/capi 新建；
# SecretKey 仅在创建时显示一次，请妥善保存到密码管理器（不要再粘进聊天 / 文档）。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# --- 腾讯云 SMS（SMS_DEV_MODE=false 时才会真正调用）---
# SMS_SDK_APP_ID：在「短信应用」列表里拿，例如 1401130267
# SMS_SIGN_NAME：「正文签名」必须是已审核通过的签名文案，公司名要与营业执照一致
# SMS_TEMPLATE_LOGIN：「正文模板管理」里类目=验证码、已审核通过的模板 ID
#                    没有审核通过的验证码模板时此项保持空，provider 会退回 DevProvider
# SMS_REGION：建议 ap-guangzhou，与短信应用所在地域一致
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_LOGIN=
# 占位符顺序，逗号分隔；可选项：code / ttl_minutes
# 单参数模板（仅 {1}=验证码）：code
# 双参数模板（{1}=验证码 {2}=分钟）：code,ttl_minutes
SMS_TEMPLATE_LOGIN_PARAMS=code
SMS_REGION=ap-guangzhou

# --- 支付 ---
# PAYMENT_DEV_MODE=true：所有支付渠道走 DevProvider —— prepay 返 stub 参数，webhook 不验签
#   此模式额外暴露 POST /v1/dev/orders/:order_no/pay 用于前端一键模拟支付成功（仅联调用）
# PAYMENT_DEV_MODE=false：必须补齐 wechat / alipay 完整配置才会启用对应渠道；缺哪个该渠道下单直接 503
# 上线前务必切到 false 并填齐密钥，否则会接收伪造回调
PAYMENT_DEV_MODE=true
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY_V3=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
